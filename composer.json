{
    "name": "alfacode-team/pulse-engine",
    "description": "Enterprise-grade PHP voting module with rate limiting, data integrity, tiered pricing, and event-driven architecture.",
    "type": "library",
    "license": "MIT",
    "keywords": ["voting", "contest", "enterprise", "psr-4", "hexagonal"],
    "authors": [
        {
            "name": "AlfaCode Team",
            "email": "shamavurasheed@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "AlfaCode\\PulseEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlfaCode\\PulseEngine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
